# The AI astrologer: it writes the five-hourly readings, and it is AI
# Astrologer Baba in the chat list. Both run on Groq's free tier, so a key
# costs nothing — make one at https://console.groq.com/keys.
#
# A key set here is compiled into the app, so it ships to every device that
# installs it — fine for a build you are testing, not for one you publish. The
# same key can instead be typed into Profile → Prediction alerts, where it stays
# on that one device.
EXPO_PUBLIC_GROQ_API_KEY=

# For a published build: your own endpoint, which holds the real key and
# forwards to the Groq chat completions API. When this is set the app sends no
# key of its own, and the one above can stay empty.
# EXPO_PUBLIC_ASTRO_AI_URL=https://api.example.com/groq

# Where phones read the published config from, when the admin dashboard
# publishes to a server (System → Sync with a server). Leave it unset and each
# device keeps the config it was given on the device itself.
# EXPO_PUBLIC_CONFIG_URL=https://api.example.com/astronepali/config
